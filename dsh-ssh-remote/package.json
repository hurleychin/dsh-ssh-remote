{
  "name": "@local/dsh-ssh-remote",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Connect this DeepSeek Harness to the DSH on another host over SSH.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": false,
      "inject": []
    }
  }
}
